# Required: PostgreSQL database url.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required for photo/logo uploads to Neon S3 Object Storage.
AWS_ENDPOINT_URL_S3="https://...aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_REGION="eu-central-1"
AWS_S3_BUCKET="mosaic"

# Local web server port.
PORT=3000

# Optional: only needed if you later enable Manus OAuth flows.
# /admin is intentionally public and does not use sign-in.
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_JWT_SECRET=
